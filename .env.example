# Diagram Tools Hub Configuration Example
# Copy this file to .env and modify the values as needed

# External Port Configuration
# HTTP port (when HTTPS is disabled)
HTTP_PORT=8080

# HTTPS port (when HTTPS is enabled)
HTTPS_PORT=8080

# SSL Configuration
# Domain name for SSL certificate generation (used as CN and SAN). In HTTPS
# mode it is also the only public hostname the hub answers: requests for any
# other Host get 421 so browsers stop reusing an h2 connection meant for a
# different service behind the same IP and certificate. Loopback is exempt.
SSL_DOMAIN=localhost

# External tools shown as extra cards on the hub landing page (optional).
# For services that live outside the hub, e.g. a DocCode instance. Entries are
# separated by ';', fields by '|':  Name|URL|Description[|LogoURL]
# Leave empty to show only the built-in tools. Quote the value (it has spaces).
# Applied on start/restart or `./manage-config.sh generate-nginx-config https`.
#EXTERNAL_TOOLS="DocCode|https://doccode.example.com/|Text-to-diagram editor: PlantUML, Mermaid, D2 and more"
EXTERNAL_TOOLS=""

# TLDraw sync backend data retention (days). Rooms not modified for this long
# (and not currently open) and uploaded assets this old that no room references
# are deleted by the sync server's periodic cleanup.
#ROOM_RETENTION_DAYS=90
#ASSET_RETENTION_DAYS=90
#CLEANUP_ENABLED=true

# TLDraw v5 license key. REQUIRED for deployments on any hostname OTHER
# than `localhost` / `127.0.0.1` — on those two the canvas works
# without a key (small corner watermark + console warning). On any
# other hostname (LAN IP, internal DNS, public URL) tldraw v5 blocks
# the canvas with a license-required overlay until a key is supplied.
#
# Get a free WatermarkOnly key at https://tldraw.dev/community/license
# (recommended for personal / OSS use). The watermark stays but the
# blocking overlay goes away. For watermark-free deployments contact
# sales@tldraw.com. See README.md → "TLDraw Licensing" for details.
#
# The key is baked into the tldraw bundle at build time; after setting
# it here run `./manage-config.sh rebuild tldraw` to apply.
# TLDRAW_LICENSE_KEY=

# Docker Configuration
COMPOSE_PROJECT_NAME=diagram-tools-hub
